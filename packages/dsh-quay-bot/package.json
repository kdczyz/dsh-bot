{
  "name": "dsh-quay-bot",
  "version": "1.0.1",
  "description": "Bot mode for DeepSeek Harness: isolated Bot personas, loop-guarded teammate messaging, Hermes-style Group Rooms, persistent Routines, a pluggable Team Memory Hub, and a bundled BotScreen virtual desktop — installs and runs with no separate dependency setup.",
  "author": "kdczyz",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "dsh-botmode",
    "botmode",
    "botscreen",
    "bot",
    "multi-agent",
    "group-room",
    "agent-team",
    "virtual-desktop",
    "vnc"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/screen.test.mjs && node test/avatar.test.mjs && node test/artifacts.test.mjs && node test/routines.test.mjs && node test/transcript.test.mjs && node test/qr.test.mjs && node test/remote.test.mjs",
    "doctor": "node bin/doctor.mjs"
  },
  "bin": {
    "dsh-quay-bot": "bin/doctor.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "avatar/**/*",
    "bin/**/*",
    "botscreen/**/*",
    "builtin-skills/**/*",
    "vendor/**/*",
    "host/**/*.js",
    "host/**/*.json",
    "cordis.patch.yml",
    "locale/*.json",
    "market/index.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
